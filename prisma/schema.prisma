generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User ids below are MarketX profile ids. Plain strings, no foreign key:
// the people live in MarketX, Posta only remembers who did what.

/// A partner shop or spot where parcels change hands.
/// A fulfilment centre: the partner shop where drivers hand parcels to couriers.
/// Only APPROVED ones receive parcels.
model HandoverPoint {
  id           String        @id @default(uuid())
  postcode     String
  name         String
  city         String
  lat          Float
  lng          Float
  contactPhone String
  address      String        @default("")
  openingHours String        @default("")
  /// The MarketX account that registered it (null for ones staff added).
  ownerUserId  String?
  status       PartnerStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  originOf     Parcel[]      @relation("ParcelOrigin")
  destinationOf Parcel[]     @relation("ParcelDestination")
  handoversOut Handover[]    @relation("HandoverFromHub")
  handoversIn  Handover[]    @relation("HandoverToHub")

  @@index([status, city])
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Someone who carries parcels the last stretch: a person, or a courier company.
model Courier {
  id            String        @id @default(uuid())
  kind          CourierKind
  /// The MarketX account that applied and manages it.
  userId        String
  /// Person's name, or the company's name.
  name          String
  phone         String
  city          String
  /// BIKE | CAR | VAN, for people.
  vehicle       String?
  /// Companies: new jobs are POSTed here, signed with webhookSecret (HMAC-SHA256).
  webhookUrl    String?
  webhookSecret String?
  status        PartnerStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  /// Taking jobs until this time (the courier's "I'm available" switch). Null or past = off.
  availableUntil DateTime?
  /// Last known position while available, for "nearest courier". Never shown exactly to senders.
  lastLat       Float?
  lastLng       Float?
  lastSeenAt    DateTime?
  legs          Leg[]
  offers        JobOffer[]

  @@unique([userId, kind])
  @@index([city, status])
}

enum CourierKind {
  INDIVIDUAL
  COMPANY
}

/// One message to one person or system. Written first, then sent and retried: nothing is lost.
model Notification {
  id            String              @id @default(uuid())
  channel       NotificationChannel
  /// Key in layers/notifications/server/utils/templates.ts
  template      String
  params        Json                @default("{}")
  /// IN_APP: who sees it. Null with forStaff = every staff member.
  toUserId      String?
  forStaff      Boolean             @default(false)
  /// WHATSAPP: who receives it.
  toPhone       String?
  /// WEBHOOK: the courier company whose system receives it.
  courierId     String?
  parcelId      String?
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime            @default(now())

  @@index([status, nextAttemptAt])
  @@index([toUserId, createdAt])
  @@index([forStaff, createdAt])
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  /// Gave up after the last retry.
  FAILED
  /// Channel not set up (e.g. no WhatsApp credentials yet): kept, not sent.
  SKIPPED
}

/// A journey someone is already making, e.g. John, Jos to Lagos on Friday.
model Trip {
  id           String     @id @default(uuid())
  driverUserId String?
  driverName   String
  driverPhone  String
  fromCity     String
  toCity       String
  departAt     DateTime
  arriveBy     DateTime
  capacity     Int
  status       TripStatus @default(OPEN)
  createdBy    String
  createdAt    DateTime   @default(now())
  legs         Leg[]
}

enum TripStatus {
  OPEN
  FULL
  DONE
}

model Parcel {
  id             String       @id @default(uuid())
  /// Shown as #1001. Readable over the phone.
  number         Int          @unique @default(autoincrement())
  /// Secret in the recipient's tracking link. The page shows their delivery code, so it must not be guessable.
  trackToken     String       @unique @default(uuid())
  /// What's inside, so the carrier knows what they're collecting.
  description    String       @default("")
  senderName     String
  senderPhone    String
  recipientName  String
  recipientPhone String
  pickupPostcode String
  /// Map pin for the pickup (from the postcode map). Shown to the sender; public pages show only the city.
  pickupLat      Float?
  pickupLng      Float?
  dropPostcode   String
  /// Map pin for the drop-off, used to pick the nearest handover point
  dropLat        Float?
  dropLng        Float?
  fromCity       String
  toCity         String
  weightKg       Float
  valueKobo      Int
  status         ParcelStatus @default(NEW)
  /// How it reaches the first centre: the sender drops it off, or a courier collects it.
  firstMile      FirstMile    @default(DROP_OFF)
  /// How it reaches the recipient: a courier to the door, or they collect at the centre.
  lastMile       LastMile     @default(DOOR)
  originHubId    String?
  originHub      HandoverPoint? @relation("ParcelOrigin", fields: [originHubId], references: [id])
  destHubId      String?
  destHub        HandoverPoint? @relation("ParcelDestination", fields: [destHubId], references: [id])
  /// The courier the sender chose for pickup, offered the job first.
  preferredCourierId String?
  createdBy      String
  createdAt      DateTime     @default(now())
  legs           Leg[]
  handovers      Handover[]
  events         Event[]
}

enum FirstMile {
  DROP_OFF
  PICKUP
}

enum LastMile {
  DOOR
  COLLECT
}

enum ParcelStatus {
  NEW
  /// Legacy (before the handover chain): matched to a trip, not yet collected.
  MATCHED
  AWAITING_DROPOFF
  AWAITING_PICKUP
  /// With the courier who collected it from the sender.
  WITH_COURIER
  AT_ORIGIN
  IN_TRANSIT
  AT_HUB
  READY_FOR_COLLECTION
  OUT_FOR_DELIVERY
  DELIVERED
}

/// One stretch of a parcel's journey, carried by one carrier (a courier or a traveller).
/// The custody changes at each end are Handover rows; the leg is who carries in between.
model Leg {
  id               String    @id @default(uuid())
  parcelId         String
  parcel           Parcel    @relation(fields: [parcelId], references: [id])
  seq              Int
  kind             LegKind
  tripId           String?
  trip             Trip?     @relation(fields: [tripId], references: [id])
  /// Null until a carrier is assigned (trip matched, or a courier accepted the offer).
  carrierName      String?
  carrierPhone     String?
  fromPostcode     String
  toPostcode       String
  windowStart      DateTime
  windowEnd        DateTime
  /// Legacy codes from before the handover chain (now on Handover rows).
  collectCode      String?
  handoverCode     String?
  /// Secret in the carrier's link, so they need no account.
  linkToken        String    @unique
  /// Wrong codes typed on this leg. Locks at 5 so a 6-digit code can't be guessed.
  failedAttempts   Int       @default(0)
  /// Last-mile legs: the courier (person or company) doing it.
  courierId        String?
  courier          Courier?  @relation(fields: [courierId], references: [id])
  offers           JobOffer[]
  handoversOut     Handover[] @relation("HandoverFromLeg")
  handoversIn      Handover[] @relation("HandoverToLeg")
  status           LegStatus @default(ASSIGNED)
  collectedAt      DateTime?
  handedOverAt     DateTime?
  handoverPostcode String?
  photoUrl         String?

  @@unique([parcelId, seq])
}

enum LegKind {
  /// Courier: sender to the origin centre.
  FIRST_MILE
  /// Between centres: a traveller (city to city) or a courier (same city).
  LINEHAUL
  /// Courier: destination centre to the door.
  LASTMILE
}

/// One change of hands. The person taking the parcel scans the giver's QR (or types its code);
/// the final recipient has no account, so they show theirs and the courier scans it.
model Handover {
  id             String         @id @default(uuid())
  parcelId       String
  parcel         Parcel         @relation(fields: [parcelId], references: [id])
  seq            Int
  fromParty      Party
  toParty        Party
  fromHubId      String?
  fromHub        HandoverPoint? @relation("HandoverFromHub", fields: [fromHubId], references: [id])
  toHubId        String?
  toHub          HandoverPoint? @relation("HandoverToHub", fields: [toHubId], references: [id])
  fromLegId      String?
  fromLeg        Leg?           @relation("HandoverFromLeg", fields: [fromLegId], references: [id])
  toLegId        String?
  toLeg          Leg?           @relation("HandoverToLeg", fields: [toLegId], references: [id])
  /// In the QR: /h/<token>. Bearer of nothing on its own: only the right party can confirm.
  token          String         @unique
  /// The same handover as 6 digits, for typing when there's no camera.
  code           String
  status         HandoverStatus @default(WAITING)
  /// Wrong codes typed for this handover. Locks at 5.
  failedAttempts Int            @default(0)
  doneAt         DateTime?
  /// Who confirmed: a user id, or "link:<legId>" for a carrier using their job link.
  doneBy         String?
  createdAt      DateTime       @default(now())

  @@unique([parcelId, seq])
  @@index([toHubId, status])
  @@index([fromHubId, status])
}

enum Party {
  SENDER
  COURIER
  CENTRE
  TRAVELLER
  RECIPIENT
}

enum HandoverStatus {
  /// Earlier steps not done yet, or a carrier not assigned yet.
  WAITING
  READY
  DONE
  CANCELLED
}

/// A job offered to one courier, who accepts or declines within a couple of minutes.
model JobOffer {
  id          String      @id @default(uuid())
  legId       String
  leg         Leg         @relation(fields: [legId], references: [id])
  courierId   String
  courier     Courier     @relation(fields: [courierId], references: [id])
  status      OfferStatus @default(OFFERED)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([courierId, status])
  @@index([legId, status])
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum LegStatus {
  ASSIGNED
  COLLECTED
  HANDED_OVER
}

/// Append-only history: parcel.matched, leg.collected, handover.completed, lastmile.created, parcel.delivered
model Event {
  id       String   @id @default(uuid())
  parcelId String
  parcel   Parcel   @relation(fields: [parcelId], references: [id])
  type     String
  data     Json     @default("{}")
  at       DateTime @default(now())

  @@index([parcelId, at])
}
