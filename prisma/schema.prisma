generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User ids below are MarketX profile ids. Plain strings, no foreign key:
// the people live in MarketX, Posta only remembers who did what.

/// A partner shop or spot where parcels change hands.
/// A fulfilment centre: the partner shop where drivers hand parcels to couriers.
/// Only APPROVED ones receive parcels.
model HandoverPoint {
  id           String        @id @default(uuid())
  postcode     String
  name         String
  city         String
  lat          Float
  lng          Float
  contactPhone String
  address      String        @default("")
  openingHours String        @default("")
  /// The MarketX account that registered it (null for ones staff added).
  ownerUserId  String?
  status       PartnerStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([status, city])
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Someone who carries parcels the last stretch: a person, or a courier company.
model Courier {
  id            String        @id @default(uuid())
  kind          CourierKind
  /// The MarketX account that applied and manages it.
  userId        String
  /// Person's name, or the company's name.
  name          String
  phone         String
  city          String
  /// BIKE | CAR | VAN, for people.
  vehicle       String?
  /// Companies: new jobs are POSTed here, signed with webhookSecret (HMAC-SHA256).
  webhookUrl    String?
  webhookSecret String?
  status        PartnerStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  legs          Leg[]

  @@unique([userId, kind])
  @@index([city, status])
}

enum CourierKind {
  INDIVIDUAL
  COMPANY
}

/// One message to one person or system. Written first, then sent and retried: nothing is lost.
model Notification {
  id            String              @id @default(uuid())
  channel       NotificationChannel
  /// Key in layers/notifications/server/utils/templates.ts
  template      String
  params        Json                @default("{}")
  /// IN_APP: who sees it. Null with forStaff = every staff member.
  toUserId      String?
  forStaff      Boolean             @default(false)
  /// WHATSAPP: who receives it.
  toPhone       String?
  /// WEBHOOK: the courier company whose system receives it.
  courierId     String?
  parcelId      String?
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime            @default(now())

  @@index([status, nextAttemptAt])
  @@index([toUserId, createdAt])
  @@index([forStaff, createdAt])
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  /// Gave up after the last retry.
  FAILED
  /// Channel not set up (e.g. no WhatsApp credentials yet): kept, not sent.
  SKIPPED
}

/// A journey someone is already making, e.g. John, Jos to Lagos on Friday.
model Trip {
  id           String     @id @default(uuid())
  driverUserId String?
  driverName   String
  driverPhone  String
  fromCity     String
  toCity       String
  departAt     DateTime
  arriveBy     DateTime
  capacity     Int
  status       TripStatus @default(OPEN)
  createdBy    String
  createdAt    DateTime   @default(now())
  legs         Leg[]
}

enum TripStatus {
  OPEN
  FULL
  DONE
}

model Parcel {
  id             String       @id @default(uuid())
  /// Shown as #1001. Readable over the phone.
  number         Int          @unique @default(autoincrement())
  /// Secret in the recipient's tracking link. The page shows their delivery code, so it must not be guessable.
  trackToken     String       @unique @default(uuid())
  /// What's inside, so the carrier knows what they're collecting.
  description    String       @default("")
  senderName     String
  senderPhone    String
  recipientName  String
  recipientPhone String
  pickupPostcode String
  /// Map pin for the pickup (from the postcode map). Shown to the sender; public pages show only the city.
  pickupLat      Float?
  pickupLng      Float?
  dropPostcode   String
  /// Map pin for the drop-off, used to pick the nearest handover point
  dropLat        Float?
  dropLng        Float?
  fromCity       String
  toCity         String
  weightKg       Float
  valueKobo      Int
  status         ParcelStatus @default(NEW)
  createdBy      String
  createdAt      DateTime     @default(now())
  legs           Leg[]
  events         Event[]
}

enum ParcelStatus {
  NEW
  MATCHED
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
}

/// One stretch of a parcel's journey, carried by one person.
/// Leg 1 = the driver's trip, leg 2 = the last-mile courier.
model Leg {
  id               String    @id @default(uuid())
  parcelId         String
  parcel           Parcel    @relation(fields: [parcelId], references: [id])
  seq              Int
  kind             LegKind
  tripId           String?
  trip             Trip?     @relation(fields: [tripId], references: [id])
  carrierName      String
  carrierPhone     String
  fromPostcode     String
  toPostcode       String
  windowStart      DateTime
  windowEnd        DateTime
  /// Held by the person handing the parcel TO the carrier.
  collectCode      String
  /// Held by the person receiving the parcel FROM the carrier.
  handoverCode     String
  /// Secret in the carrier's link, so they need no account.
  linkToken        String    @unique
  /// Wrong codes typed on this leg. Locks at 5 so a 6-digit code can't be guessed.
  failedAttempts   Int       @default(0)
  /// Last-mile legs: the courier (person or company) doing it.
  courierId        String?
  courier          Courier?  @relation(fields: [courierId], references: [id])
  status           LegStatus @default(ASSIGNED)
  collectedAt      DateTime?
  handedOverAt     DateTime?
  handoverPostcode String?
  photoUrl         String?

  @@unique([parcelId, seq])
}

enum LegKind {
  LINEHAUL
  LASTMILE
}

enum LegStatus {
  ASSIGNED
  COLLECTED
  HANDED_OVER
}

/// Append-only history: parcel.matched, leg.collected, handover.completed, lastmile.created, parcel.delivered
model Event {
  id       String   @id @default(uuid())
  parcelId String
  parcel   Parcel   @relation(fields: [parcelId], references: [id])
  type     String
  data     Json     @default("{}")
  at       DateTime @default(now())

  @@index([parcelId, at])
}
