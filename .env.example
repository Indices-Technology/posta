# Posta's own database (NOT the MarketX one). Local Postgres or a separate Neon project.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/posta

# Where MarketX lives. https://marketx.africa, or http://localhost:3000 when marketX dev is running (Posta runs on 3100)
NUXT_MARKETX_API_URL=https://marketx.africa

# National postcode API secret key (docs.postcode.gov.ng, Settings > API Keys).
# Only a nipost_live_ key checks real postcodes; test keys know 5 FCT sandbox buildings only.
NUXT_POSTCODE_API_KEY=

# ── Shipping API (/api/v1, used by MarketX) ──
# One entry per client: "name:<sha256 hex of its key>", comma-separated. Generate: see layers/shipping/server/utils/apiKey.ts
NUXT_API_KEYS=
# Offer Posta's own network in quotes. Keep false until the rate card in layers/shipping/server/utils/networkPrice.ts is real.
NUXT_NETWORK_QUOTES=false
# Where each client receives shipment status webhooks, and the secret they are signed with (JSON).
NUXT_CLIENT_WEBHOOKS={"marketx":{"url":"https://marketx.indicestech.com/api/posta/webhook","secret":"whsec_change_me"}}
# Staging only: allow POST /api/v1/shipments/:code/simulate (fake carrier scans). Never true in production.
POSTA_ALLOW_SIMULATE=false
# GIG Logistics (same account as MarketX). GIG is never quoted unless GIG_ENABLED=true.
GIG_ENABLED=false
GIG_BASE_URL=
GIG_EMAIL=
GIG_PASSWORD=
GIG_CUSTOMER_CODE=
GIG_CUSTOMER_TYPE=0
# Markup on carrier cost (not on seller-priced or Posta network quotes). 0.25 = cost x 1.25
SHIPPING_MARKUP_PCT=0.25
SHIPPING_HANDLING_FEE=0
