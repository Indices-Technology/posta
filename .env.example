# Posta's own database (NOT the MarketX one). Local Postgres or a separate Neon project.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/posta

# Where MarketX lives. https://marketx.africa, or http://localhost:3000 when marketX dev is running (Posta runs on 3100)
NUXT_MARKETX_API_URL=https://marketx.africa

# National postcode API secret key (docs.postcode.gov.ng, Settings > API Keys).
# Only a nipost_live_ key checks real postcodes; test keys know 5 FCT sandbox buildings only.
NUXT_POSTCODE_API_KEY=
